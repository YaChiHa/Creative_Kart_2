# Copy to .env.local and fill these from Supabase > Project Settings > API.
# Use only the project's public anon/publishable key in a browser app.
# NEVER put a service_role/secret key in VITE_ variables or commit real credentials.
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
